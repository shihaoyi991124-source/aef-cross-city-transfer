    },
    "Xian": {
      "crs": "EPSG:32649"
    },
    "Beijing": {
      "crs": "EPSG:32650"
    }
  },
  "selected_multicity_cities": [
    "Shenzhen",
    "Kunming",
    "Wuhan",
    "Xian",
    "Beijing"
  ],
  "stage_03": {
    "random_seeds": [20261008, 20261009, 20261010, 20261011, 20261012],
    "split": {
      "train_fraction": 0.70,
      "validation_fraction": 0.15,
      "test_fraction": 0.15,
      "search_candidates": 1500,
