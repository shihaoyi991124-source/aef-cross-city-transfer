  "stage_05": {
    "feature_set": "AEF-192",
    "knn_values": [1, 5, 10],
    "primary_k": 5,
    "bootstrap_resamples": 1000,
    "bootstrap_seed": 20261008,
    "bootstrap_unit": "2_km_target_block",
    "domain_discrepancy_samples_per_city": 2000,
    "mmd_bandwidth_sample_size": 1000,
    "error_model": "XGBoost",
    "error_distance_k": 5
