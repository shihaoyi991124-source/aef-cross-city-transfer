        "min_child_weight": 1.0,
        "reg_lambda": 1.0,
        "early_stopping_rounds": 30,
        "tree_method": "hist",
        "n_jobs": 4
      }
    },
    "go_no_go": {
      "domain_auc_threshold": 0.75,
      "cross_city_macro_f1_degradation_threshold": 0.08
    }
  },
  "stage_04": {
    "feature_set": "AEF-192",
    "target_label_percentages": [1, 5, 10, 25],
    "recovery_denominator_threshold": 0.02,
    "selection_unit": "spatial_block",
    "nested_sampling": true,
    "adaptation_pool": "target_train_and_validation_blocks"
